{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": ["node"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"verbatimModuleSyntax": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"noEmit": true,
		// bench/ runs under node's own type stripping, which resolves ESM
		// specifiers verbatim and so needs the .ts extension written out
		"allowImportingTsExtensions": true,
		"skipLibCheck": true
	},
	"include": ["src", "bench", "tsup.config.ts", "vitest.config.ts", "vite.config.ts"],
	"exclude": ["src/runtime", "src/ui"]
}
