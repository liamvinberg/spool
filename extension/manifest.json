{
	"manifest_version": 3,
	"name": "spool",
	"version": "0.2.0",
	"description": "Send anything on a web page to the spool canvas on your Mac, as a reference: its markup, styles and motion.",
	"icons": {
		"16": "icons/16.png",
		"32": "icons/32.png",
		"48": "icons/48.png",
		"128": "icons/128.png"
	},
	"action": {
		"default_title": "spool  ⌥⇧S",
		"default_icon": {
			"16": "icons/16.png",
			"32": "icons/32.png"
		}
	},
	"commands": {
		"_execute_action": {
			"suggested_key": {
				"default": "Alt+Shift+S",
				"mac": "Alt+Shift+S"
			}
		}
	},
	"background": {
		"service_worker": "background.js"
	},
	"permissions": ["activeTab", "scripting", "storage"],
	"minimum_chrome_version": "114",
	"key": ""
}
