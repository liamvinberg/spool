<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The hardened runtime is required for notarization, and a Node runtime
	     cannot live under it unamended. All three of these are about the bundled
	     node, not about this app's own code:

	     allow-jit and allow-unsigned-executable-memory: V8 compiles JavaScript to
	     machine code at runtime and writes it into pages it then executes, which
	     the hardened runtime forbids by default.

	     disable-library-validation: spool's dependency tree carries native addons
	     (esbuild, tailwind's oxide, and whatever else npm resolves), and those
	     .node and .dylib files are signed with this app's certificate at package
	     time but were never built by it. Library validation would refuse to load
	     code the main binary's team did not produce.

	     Nothing here weakens the sandbox, because there is no sandbox: this is a
	     Developer ID app that starts a local server, not an App Store one. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
