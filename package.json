{
	"name": "spool.page",
	"version": "0.0.0",
	"description": "Live prototyping canvas: agent-authored TSX frames on an infinite canvas, repo-native.",
	"repository": "github:devosurf/spool",
	"type": "module",
	"bin": {
		"spool": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@11.5.3",
	"scripts": {
		"dev": "tsx src/cli.ts",
		"build": "rm -rf dist && tsup && vite build",
		"prepack": "rm -rf dist && tsup && vite build",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.runtime.json --noEmit && tsc -p tsconfig.ui.json --noEmit",
		"check": "biome check .",
		"test": "vitest run",
		"build:ui": "vite build"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@fontsource-variable/familjen-grotesk": "^5.3.0",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "^22.20.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.3",
		"happy-dom": "^20.11.0",
		"tsup": "^8.5.1",
		"tsx": "^4.23.1",
		"typescript": "^7.0.2",
		"vite": "^8.1.5",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@fontsource/fragment-mono": "^5.3.0",
		"@hono/node-server": "^2.0.10",
		"@tailwindcss/oxide": "4.3.3",
		"commander": "^15.0.0",
		"esbuild": "^0.28.1",
		"hono": "^4.12.31",
		"launch-editor": "^2.14.1",
		"playwright-core": "^1.61.1",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"tailwindcss": "4.3.3",
		"trash": "^10.1.1",
		"zod": "^4.4.3"
	}
}
