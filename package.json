{
	"name": "spool.page",
	"version": "0.0.0",
	"description": "Live prototyping canvas: agent-authored TSX frames on an infinite canvas, repo-native.",
	"repository": "github:devosurf/spool",
	"type": "module",
	"bin": {
		"spool": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@11.5.3",
	"scripts": {
		"dev": "tsx src/cli.ts",
		"build": "tsup",
		"typecheck": "tsc --noEmit",
		"check": "biome check .",
		"test": "vitest run"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.5",
		"@types/node": "^22.20.1",
		"tsup": "^8.5.1",
		"tsx": "^4.23.1",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
