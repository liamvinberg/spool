{
	"name": "spool.page",
	"version": "0.4.0",
	"description": "Live prototyping canvas: agent-authored TSX frames on an infinite canvas, repo-native.",
	"repository": "github:liamvinberg/spool",
	"homepage": "https://spool.page",
	"license": "MIT",
	"type": "module",
	"bin": {
		"spool": "./dist/cli.js"
	},
	"files": [
		"dist",
		"LICENSE.md",
		"THIRD_PARTY_NOTICES.md"
	],
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@11.5.3",
	"scripts": {
		"dev": "SPOOL_DIR=$HOME/.spool-dev SPOOL_PORT=7767 tsx src/dev.ts",
		"build": "rm -rf dist && tsup && vite build && cp src/runtime/spool-public.ts dist/spool-public.d.ts",
		"prepack": "rm -rf dist && tsup && vite build && cp src/runtime/spool-public.ts dist/spool-public.d.ts",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.runtime.json --noEmit && tsc -p tsconfig.ui.json --noEmit && tsc -p bench/evidence/tsconfig.json --noEmit",
		"check": "biome check .",
		"test": "vitest run",
		"build:ui": "vite build"
	},
	"devDependencies": {
		"@babel/types": "^7.29.7",
		"@biomejs/biome": "^2.5.5",
		"@changesets/cli": "^2.31.1",
		"@fontsource-variable/familjen-grotesk": "^5.3.0",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "^22.20.1",
		"@types/ws": "^8.18.1",
		"@vitejs/plugin-react": "^6.0.3",
		"happy-dom": "^20.11.0",
		"tsup": "^8.5.1",
		"tsx": "^4.23.1",
		"vite": "^8.1.5",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@babel/parser": "^7.29.7",
		"@fontsource/fragment-mono": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@hono/node-server": "^2.0.10",
		"@tailwindcss/oxide": "4.3.3",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@xterm/addon-serialize": "^0.14.0",
		"@xterm/addon-webgl": "0.19.0",
		"@xterm/headless": "^6.0.0",
		"@xterm/xterm": "6.0.0",
		"commander": "^15.0.0",
		"esbuild": "^0.28.1",
		"hono": "^4.12.31",
		"launch-editor": "^2.14.1",
		"pdf-lib": "1.17.1",
		"playwright-core": "^1.61.1",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"tailwindcss": "4.3.3",
		"trash": "^10.1.1",
		"typescript": "7.0.2",
		"ws": "^8.21.1",
		"zod": "^4.4.3"
	}
}
