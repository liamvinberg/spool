{
	"name": "spool.page",
	"version": "0.33.0",
	"description": "Live prototyping canvas: agent-authored TSX frames on an infinite canvas, repo-native.",
	"repository": "github:liamvinberg/spool",
	"homepage": "https://spool.page",
	"license": "MIT",
	"type": "module",
	"bin": {
		"spool": "./dist/cli.js"
	},
	"exports": {
		"./compile": {
			"types": "./dist/types/compile-entry.d.ts",
			"default": "./dist/compile.js"
		},
		"./vendor": {
			"types": "./dist/types/vendor.d.ts",
			"default": "./dist/vendor.js"
		},
		"./sync-protocol": {
			"types": "./dist/types/team-sync-protocol.d.ts",
			"default": "./dist/sync-protocol.js"
		},
		"./viewer/*": "./dist/viewer/*",
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"LICENSE.md",
		"THIRD_PARTY_NOTICES.md"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"packageManager": "pnpm@11.5.3",
	"scripts": {
		"dev": "tsx src/dev.ts",
		"build": "rm -rf dist && tsup && vite build && vite build -c vite.viewer.config.ts && cp src/runtime/spool-public.ts dist/spool-public.d.ts && tsc -p tsconfig.compile.json",
		"prepack": "rm -rf dist && tsup && vite build && vite build -c vite.viewer.config.ts && cp src/runtime/spool-public.ts dist/spool-public.d.ts && tsc -p tsconfig.compile.json",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.runtime.json --noEmit && tsc -p tsconfig.ui.json --noEmit && tsc -p bench/evidence/tsconfig.json --noEmit",
		"check": "biome check .",
		"test": "vitest run",
		"test:performance": "SPOOL_TEST_PERFORMANCE=1 vitest run src/daemon/hand-text-browser.test.ts src/daemon/flows-budget.test.ts --maxWorkers=1 --retry=0",
		"build:ui": "vite build"
	},
	"devDependencies": {
		"@babel/parser": "^7.29.7",
		"@babel/traverse": "^7.29.8",
		"@babel/types": "^7.29.7",
		"@biomejs/biome": "^2.5.5",
		"@changesets/cli": "^2.31.1",
		"@earendil-works/pi-agent-core": "0.85.1",
		"@earendil-works/pi-ai": "0.85.1",
		"@earendil-works/pi-coding-agent": "0.85.1",
		"@hono/node-server": "^2.0.10",
		"@tailwindcss/oxide": "4.3.3",
		"@tailwindcss/vite": "4.3.3",
		"@types/babel__traverse": "^7.28.0",
		"@types/node": "^22.20.1",
		"@types/ws": "^8.18.1",
		"@vitejs/plugin-react": "^6.0.3",
		"commander": "^15.0.0",
		"esbuild-wasm": "0.28.1",
		"fake-indexeddb": "^6.2.5",
		"fflate": "^0.8.3",
		"happy-dom": "^20.11.0",
		"hono": "^4.12.31",
		"motion": "12.42.2",
		"pdf-lib": "1.17.1",
		"tsup": "^8.5.1",
		"tsx": "^4.23.1",
		"typebox": "1.3.7",
		"undici": "^7.29.1",
		"vite": "^8.1.5",
		"vitest": "^4.1.10",
		"zod": "^4.4.3"
	},
	"dependencies": {
		"@anthropic-ai/sandbox-runtime": "0.0.75",
		"@fontsource-variable/instrument-sans": "^5.3.0",
		"@fontsource/fragment-mono": "^5.3.0",
		"@silvia-odwyer/photon-node": "0.3.4",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"esbuild": "0.28.1",
		"playwright-core": "^1.61.1",
		"react": "19.2.7",
		"react-dom": "19.2.7",
		"tailwindcss": "4.3.3",
		"trash": "^10.1.1",
		"typescript": "7.0.2"
	}
}
